# Fallback SSH config for github.com.
# Primary git auth now goes through HTTPS + the gh CLI credential helper
# (see .gitconfig [credential "https://github.com"]), which avoids a YubiKey
# touch on every push/pull. This stays configured for anything that still
# uses git@github.com SSH remotes/URLs.
Host github.com
    User git
    IdentityFile C:\Users\ItsJustMech\.ssh\yubikey_sk
    IdentitiesOnly yes
