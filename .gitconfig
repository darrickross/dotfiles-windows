[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	defaultBranch = main
[user]
	email = me@darrickross.com
    name = Darrick Ross
	signingkey = DF1B93A0B3CDCF394B9D2708108B3A7D41B13305
[gpg]
	program = C:\\Program Files (x86)\\GnuPG\\bin\\gpg.exe
	format = openpgp
[commit]
	gpgSign = true
[core]
	autocrlf = true
# Primary auth for github.com/gist.github.com: HTTPS via gh CLI's cached
# OAuth token, so push/pull don't need a YubiKey touch each time (see `gh auth
# status`). SSH (.ssh/configs/github.ssh_config) is kept configured as a
# fallback for anything that still uses git@github.com SSH remotes.
# The empty `helper =` line resets the helper list inherited from the system
# config (credential.helper = manager) so only gh's helper runs for these hosts.
[credential "https://github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
